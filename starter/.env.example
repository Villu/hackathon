# Copy to .env and fill in. Never commit .env.

# --- LLM ---------------------------------------------------------------------
LLM_PROVIDER=gemini                      # gemini | mock  (mock = no key needed, canned answers)
GEMINI_API_KEY=                          # your TEAM key
GEMINI_PRIMARY_MODEL=gemini-2.5-flash    # ~0.8 s/call with thinking off; newer Flash models are slower
GEMINI_FAST_MODEL=gemini-3.1-flash-lite  # fallback tier (2.5-flash-lite is closed to new keys)
GEMINI_THINKING_BUDGET=0                 # 0 = thinking off (6 s -> 0.8 s per call); -1 = model default

# --- Azure (MCP tools) -------------------------------------------------------
MOCK_AZURE=true                          # false → real Azure via `az login`
AZURE_SUBSCRIPTION_ID=e419a266-2639-4134-9ded-7a777b020ae9   # GPT Initium
AZURE_RESOURCE_GROUP=VilluResourceGroup
LOG_ANALYTICS_WORKSPACE_ID=              # posted by the facilitator (workspace customerId GUID)

# --- Stream ------------------------------------------------------------------
STREAM_SOURCE=rest                       # rest | kafka
KAFKA_BOOTSTRAP=localhost:19092
DECISION_WEBHOOK_URL=

# --- Reliability (spec section 7) -------------------------------------------
LLM_PRIMARY_BUDGET_MS=3000               # per model call; the first decision comes from rules anyway
LLM_FAST_BUDGET_MS=2000
ENRICH_DEADLINE_MS=15000
CONFIDENCE_THRESHOLD=0.7
LLM_RPS=5
LLM_BURST=10
CB_FAILURES=5
MAX_TOOL_ROUNDS=4
TOOL_TIMEOUT_MS=2500
QUEUE_MAX=1000
WORKERS=8

# --- Process -----------------------------------------------------------------
MCP_ENABLED=true
LOG_LEVEL=INFO
